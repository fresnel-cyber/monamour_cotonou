---
import { sections, faq } from '../content';

const { eyebrow, title } = sections.faq;
---

<section class="px-6 py-20 md:px-12 md:py-32">
  <div class="mx-auto max-w-3xl">
    <div data-reveal class="mb-12">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.25em] text-terracotta">
        {eyebrow}
      </p>
      <h2 class="font-serif text-4xl leading-tight text-espresso md:text-5xl">
        {title}
      </h2>
    </div>

    <div class="divide-y divide-espresso/10 border-t border-b border-espresso/10">
      {faq.map((item) => (
        <details data-reveal class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg text-espresso md:text-xl">
            {item.question}
            <span
              class="shrink-0 text-2xl text-terracotta transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-espresso/75">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
